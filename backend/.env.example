# Storage Configuration
# Options: "json" (local file) or "dynamodb" (AWS)
STORAGE_TYPE=json

# JSON File Storage (for local deployment)
DATA_DIR=./data

# DynamoDB Storage (for AWS deployment)
# Uncomment and configure when using DynamoDB
# DYNAMODB_TABLE_NAME=ClipboardEntries
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# or use AWS_PROFILE=your-profile-name for AWS CLI profiles

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173
