// Prisma schema for clipboard manager

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ClipboardEntry {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  userId    String?  // Optional: for future multi-user support
  device    String?  // Optional: track which device it came from

  @@index([createdAt])
  @@index([userId])
}
